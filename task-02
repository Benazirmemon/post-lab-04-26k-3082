#include <stdio.h>

int main()
{
    int days;

    printf("Enter late days: ");
    scanf("%d", &days);

    if (days == 0)
        printf("No Fine");
    else if (days >= 1 && days <= 5)
        printf("Fine: Rs. 50");
    else if (days >= 6 && days <= 10)
        printf("Fine: Rs. 100");
    else
        printf("Fine: Rs. 200");

    return 0;
}
